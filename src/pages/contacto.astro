---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import MobileMenu from '../components/MobileMenu.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import site from '../data/site.json';

const title = 'Contacto · Maison YR';
const description = `Hablemos. Atención personalizada, eventos privados y consultas de la maison ${site.name}.`;
const phone = site.contact.whatsapp.replace(/\D/g, '');
const whatsappHref = `https://wa.me/${phone}?text=${encodeURIComponent(site.contact.whatsappMessage)}`;
---

<BaseLayout title={title} description={description}>
  <Nav />
  <MobileMenu />
  <main id="main">
    <section class="institutional-hero">
      <div class="institutional-kicker">La Maison</div>
      <h1 class="institutional-title">Contacto</h1>
      <p class="institutional-lede">
        Atención personalizada, prensa, ventas privadas y consultas sobre piezas a medida.
        Respondemos en menos de 24 horas hábiles.
      </p>
    </section>

    <section class="contact-grid-section">
      <div class="contact-grid">
        <article class="contact-card">
          <div class="contact-card-label">Correo</div>
          <a class="contact-card-value" href={`mailto:${site.contact.email}`} data-interactive>
            {site.contact.email}
          </a>
          <p class="contact-card-note">Atención general, prensa y ventas.</p>
        </article>

        <article class="contact-card">
          <div class="contact-card-label">WhatsApp</div>
          <a class="contact-card-value" href={whatsappHref} target="_blank" rel="noopener noreferrer" data-interactive>
            {site.contact.whatsappDisplay ?? site.contact.phone}
          </a>
          <p class="contact-card-note">Respuesta más rápida · 9 a 18 hs (COT).</p>
        </article>

        <article class="contact-card">
          <div class="contact-card-label">Maison</div>
          <span class="contact-card-value">{site.contact.addressLine}</span>
          <p class="contact-card-note">
            Visitas con cita previa.
            <a href={whatsappHref} target="_blank" rel="noopener" data-interactive>Agendá por WhatsApp →</a>
          </p>
        </article>

        <article class="contact-card">
          <div class="contact-card-label">Redes</div>
          <div class="contact-card-links">
            <a href={site.social.instagram} target="_blank" rel="noopener" data-interactive>Instagram →</a>
            <a href={site.social.tiktok} target="_blank" rel="noopener" data-interactive>TikTok →</a>
          </div>
          <p class="contact-card-note">Lanzamientos, behind the scenes y eventos privados.</p>
        </article>
      </div>
    </section>
  </main>
  <Footer />
  <WhatsAppFloat />
</BaseLayout>

<style>
  .institutional-hero {
    padding: 160px 56px 80px;
    text-align: center;
    background: radial-gradient(ellipse at 50% 30%, rgba(212, 178, 102, 0.08), transparent 60%);
  }
  .institutional-kicker {
    font-family: 'Manrope', sans-serif;
    font-size: 11px;
    letter-spacing: 0.5em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 28px;
  }
  .institutional-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(48px, 7vw, 92px);
    font-weight: 300;
    line-height: 1;
    color: var(--ink);
    margin-bottom: 32px;
  }
  .institutional-lede {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 20px;
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 680px;
    margin: 0 auto;
  }

  .contact-grid-section {
    padding: 60px 56px 120px;
    background: var(--black);
  }
  .contact-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
    max-width: 1100px;
    margin: 0 auto;
  }
  .contact-card {
    padding: 36px 32px;
    background: var(--black-2);
    border: 1px solid var(--line-soft);
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition:
      transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1),
      border-color 0.3s;
  }
  .contact-card:hover {
    transform: translateY(-3px);
    border-color: var(--gold-soft);
  }
  .contact-card-label {
    font-family: 'Manrope', sans-serif;
    font-size: 10px;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .contact-card-value {
    font-family: 'Cormorant Garamond', serif;
    font-size: 26px;
    color: var(--ink);
    text-decoration: none;
    line-height: 1.2;
    transition: color 0.3s;
  }
  a.contact-card-value:hover {
    color: var(--gold);
  }
  .contact-card-note {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 16px;
    color: var(--ink-soft);
    line-height: 1.55;
    margin-top: 4px;
  }
  .contact-card-note a {
    color: var(--gold);
    text-decoration: none;
    border-bottom: 1px solid var(--gold-soft);
    transition: border-color 0.3s;
    margin-left: 4px;
  }
  .contact-card-note a:hover {
    border-color: var(--gold);
  }
  .contact-card-links {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
  }
  .contact-card-links a {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 22px;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--gold-soft);
    transition:
      color 0.3s,
      border-color 0.3s;
  }
  .contact-card-links a:hover {
    color: var(--gold);
    border-color: var(--gold);
  }

  @media (max-width: 980px) {
    .institutional-hero {
      padding: 130px 24px 60px;
    }
    .contact-grid-section {
      padding: 40px 24px 100px;
    }
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
  @media (max-width: 600px) {
    .institutional-hero {
      padding: 110px 18px 50px;
    }
    .contact-grid-section {
      padding: 30px 18px 80px;
    }
    .institutional-lede {
      font-size: 17px;
    }
    .contact-card {
      padding: 28px 22px;
    }
    .contact-card-value {
      font-size: 22px;
    }
  }
</style>
