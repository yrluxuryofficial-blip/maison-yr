---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import MobileMenu from '../components/MobileMenu.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';

const title = 'Preguntas frecuentes · Maison YR';
const description =
  'Tallas, envíos, cuidado de las piezas, garantía y devoluciones. Las dudas más frecuentes sobre Maison YR.';

const faqs = [
  {
    q: '¿Cómo elijo mi talla en lencería?',
    a: '[REVISAR] Cada conjunto está pensado para sentirse antes que para verse. Las tallas van de XS a XL. Si estás entre dos, te recomendamos la más grande. Escribinos por WhatsApp con tus medidas (busto, cintura, cadera) y te orientamos.',
  },
  {
    q: '¿Las fragancias son unisex?',
    a: '[REVISAR] La Eau de Parfum N°III está construida sobre una pirámide olfativa floral con base ambarada. Funciona como signature para cualquier piel, pero su firma original es femenina. Próximamente lanzamos una variante masculina.',
  },
  {
    q: '¿Cómo cuido las piezas de lencería?',
    a: 'Lavado a mano con agua fría y jabón neutro. Sin secadora, sin lavarropa. Los herrajes dorados pueden oscurecerse con detergentes agresivos, usá jabón específico para encajes. Guardalas en su bolsa original de la maison.',
  },
  {
    q: '¿El lipgloss es vegano y libre de crueldad?',
    a: 'Libre de crueldad, sí. La fórmula no fue testeada en animales. La fórmula es vegana en 5 de los 6 tonos; consultá el listado completo de ingredientes en el packaging. Apto para labios sensibles.',
  },
  {
    q: '¿Hacen envíos internacionales?',
    a: '[COMPLETAR] Sí, despachamos a [LISTA DE PAÍSES] con cotización individual. Los tiempos van de 7 a 14 días hábiles y los costos varían según el destino. Escribinos por WhatsApp con tu ciudad y el producto que te interesa para coordinar.',
  },
  {
    q: '¿Cuál es la política de cambios?',
    a: 'Aceptamos cambios dentro de los 15 días posteriores a la recepción si la pieza no fue usada y conserva su empaque original. Lencería y productos de belleza solo aceptan cambio por talla, no devolución por motivos de higiene. Más detalles en la página de Envíos.',
  },
];
---

<BaseLayout title={title} description={description}>
  <Nav />
  <MobileMenu />
  <main id="main">
    <section class="institutional-hero">
      <div class="institutional-kicker">La Maison</div>
      <h1 class="institutional-title">Preguntas <em>frecuentes</em></h1>
      <p class="institutional-lede">
        Las dudas que escuchamos seguido. Si tu pregunta no está acá, escribinos por WhatsApp.
        Respondemos en menos de 24 horas.
      </p>
    </section>

    <section class="faq-section">
      <div class="faq-list">
        {
          faqs.map((item, i) => (
            <details class="faq-item" open={i === 0}>
              <summary class="faq-question" data-interactive>
                <span class="faq-question-text">{item.q}</span>
                <span class="faq-icon" aria-hidden="true">
                  +
                </span>
              </summary>
              <div class="faq-answer">
                <p>{item.a}</p>
              </div>
            </details>
          ))
        }
      </div>
    </section>
  </main>
  <Footer />
  <WhatsAppFloat />
</BaseLayout>

<style>
  .institutional-hero {
    padding: 160px 56px 80px;
    text-align: center;
    background: radial-gradient(ellipse at 50% 30%, rgba(212, 178, 102, 0.08), transparent 60%);
  }
  .institutional-kicker {
    font-family: 'Manrope', sans-serif;
    font-size: 11px;
    letter-spacing: 0.5em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 28px;
  }
  .institutional-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(48px, 7vw, 92px);
    font-weight: 300;
    line-height: 1;
    color: var(--ink);
    margin-bottom: 32px;
  }
  .institutional-title em {
    font-family: 'Forum', serif;
    font-style: normal;
    color: var(--gold);
  }
  .institutional-lede {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 20px;
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 680px;
    margin: 0 auto;
  }

  .faq-section {
    padding: 60px 56px 120px;
    background: var(--black);
  }
  .faq-list {
    max-width: 880px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
  }
  .faq-item {
    border-bottom: 1px solid var(--line-soft);
  }
  .faq-item:first-child {
    border-top: 1px solid var(--line-soft);
  }
  .faq-question {
    list-style: none;
    cursor: pointer;
    padding: 28px 8px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    transition: padding-left 0.3s;
  }
  .faq-question::-webkit-details-marker {
    display: none;
  }
  .faq-question:hover {
    padding-left: 16px;
  }
  .faq-question-text {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(20px, 2vw, 24px);
    font-style: italic;
    color: var(--ink);
    line-height: 1.3;
    flex: 1;
  }
  .faq-icon {
    width: 32px;
    height: 32px;
    border: 1px solid var(--gold-soft);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--gold);
    font-family: 'Forum', serif;
    font-size: 18px;
    transition:
      transform 0.4s,
      background 0.3s,
      color 0.3s;
    flex-shrink: 0;
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    background: var(--gold);
    color: var(--black);
  }
  .faq-answer {
    padding: 0 8px 32px;
  }
  .faq-answer p {
    font-family: 'Cormorant Garamond', serif;
    font-size: 18px;
    line-height: 1.7;
    color: var(--ink-soft);
    max-width: 720px;
    padding-left: 16px;
    border-left: 1px solid var(--gold-soft);
  }

  @media (max-width: 980px) {
    .institutional-hero {
      padding: 130px 24px 60px;
    }
    .faq-section {
      padding: 40px 24px 100px;
    }
  }
  @media (max-width: 600px) {
    .institutional-hero {
      padding: 110px 18px 50px;
    }
    .faq-section {
      padding: 30px 18px 80px;
    }
    .institutional-lede {
      font-size: 17px;
    }
    .faq-question {
      padding: 22px 4px;
    }
    .faq-question-text {
      font-size: 18px;
    }
    .faq-answer p {
      font-size: 16px;
    }
  }
</style>
