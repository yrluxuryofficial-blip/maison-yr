---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import MobileMenu from '../components/MobileMenu.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import site from '../data/site.json';

const title = 'Historia & Concepto · Maison YR';
const description = `La historia de ${site.name}: el concepto, la fundadora Yesenia Rodríguez, el origen colombiano y la visión 2030.`;

// 6 valores que componen la esencia de la maison.
const valores = [
  {
    roman: 'I',
    title: 'Sensualidad',
    body: 'Cada pieza es una conversación íntima entre la prenda y la piel. La sensualidad no se grita — se habita, se viste, se respira.',
  },
  {
    roman: 'II',
    title: 'Elegancia',
    body: 'La elegancia es lo que queda cuando todo lo demás se olvida. Líneas limpias, materiales nobles, sin estridencias.',
  },
  {
    roman: 'III',
    title: 'Artesanía',
    body: 'Encaje europeo tejido en Calais, satén de seda, herrajes dorados grabados a mano. Cada detalle es decisión, nunca azar.',
  },
  {
    roman: 'IV',
    title: 'Detalle',
    body: 'El monograma YR en cada herraje. La caja de terciopelo verde esmeralda. El certificado numerado. Nada es accesorio.',
  },
  {
    roman: 'V',
    title: 'Origen',
    body: 'Nacida en Medellín con vocación internacional. La esmeralda colombiana y la elegancia francesa convergen en cada pieza.',
  },
  {
    roman: 'VI',
    title: 'Firma',
    body: 'No es una marca — es una manera de habitar el mundo. Una firma que se reconoce sin necesidad de logo visible.',
  },
];

// 6 puntos de la visión a 2030.
const vision = [
  'Nuevas líneas de Eau de Parfum para hombre y ediciones limitadas estacionales.',
  'Línea de accesorios en cuero y joyería fina con monograma YR.',
  'Expansión de presencia a Europa — París como capital olfativa.',
  'Apertura en Medio Oriente — Dubái como puerta al mercado de lujo regional.',
  'Boutique física insignia en Colombia con experiencia atelier inmersiva.',
  'Eventos privados internacionales para el Cercle YR — pre-lanzamientos exclusivos.',
];
---

<BaseLayout title={title} description={description}>
  <Nav />
  <MobileMenu />
  <main id="main">
    <section class="institutional-hero">
      <div class="institutional-kicker">— La Maison</div>
      <h1 class="institutional-title">Historia <em>&amp; Concepto</em></h1>
      <p class="institutional-lede">
        Una maison nacida en Medellín con vocación internacional. La historia de una idea — la
        sensualidad como firma — y de la mujer que decidió construirla.
      </p>
    </section>

    <!-- =========================================
         CONCEPTO + pull-quote
         ========================================= -->
    <section class="historia-section" id="concepto">
      <div class="historia-inner narrow">
        <div class="historia-eyebrow">— Capítulo I · Manifiesto</div>
        <h2 class="historia-h2">Más que <em>lencería</em>.<br />Una <em>firma</em>.</h2>

        <p class="historia-paragraph">
          Maison YR no nació para seguir tendencias. Nació para crear <em>presencia</em>.
        </p>

        <p class="historia-paragraph">
          Creemos en la lencería como una <em>extensión de la mujer que la lleva</em>:
          segura, elegante, inolvidable. Cada pieza está diseñada para sentirse íntima y
          poderosa al mismo tiempo — <strong>como un secreto que no necesita explicación</strong>.
        </p>

        <p class="historia-paragraph">
          Nuestra historia une tres mundos: la <em>sensualidad de la lencería europea</em>,
          la <em>perfumería de autor inspirada en Grasse</em> y la <em>estética contemporánea
          del luxury beauty</em>.
        </p>

        <p class="historia-paragraph editorial-highlight">
          No creamos productos por volumen.<br />
          Creamos <em>objetos con intención</em>.
        </p>

        <p class="historia-paragraph">
          Ediciones cuidadas, detalles exclusivos y una identidad pensada para
          <em>permanecer en la memoria</em> de quien la descubre.
        </p>

        <p class="manifesto-closing">
          Maison YR es más que moda.<br />
          Es una <em>firma</em>.<br />
          Una <em>actitud</em>.<br />
          Una forma de <strong>entrar en una habitación sin pedir permiso</strong>.
        </p>
      </div>

      <blockquote class="pullquote">
        <p>
          "No vendo solo lencería.<br />
          Vendo <strong>seguridad</strong>, <strong>elegancia</strong> y una <strong>sensación</strong>."
        </p>
        <cite>— Yesenia Rodríguez · Fondatrice</cite>
      </blockquote>
    </section>

    <!-- =========================================
         FUNDADORA
         ========================================= -->
    <section class="historia-section alt" id="fundadora">
      <div class="historia-grid">
        <div class="historia-portrait">
          <div class="portrait-frame" aria-hidden="true">
            <div class="portrait-emblem"><span>YR</span></div>
            <div class="portrait-placeholder-label">— Yesenia Rodríguez</div>
          </div>
        </div>
        <div class="historia-grid-text">
          <div class="historia-eyebrow">— Capítulo II · La Fundadora</div>
          <h2 class="historia-h2"><em>Yesenia</em><br />Rodríguez.</h2>
          <p class="founder-credentials">
            Española de raíces canarias.<br />
            Empresaria, creadora y mujer de visión.
          </p>

          <p class="historia-paragraph">
            Yesenia Rodríguez no creó Maison YR desde una oficina ni desde una estrategia vacía de
            marketing. La creó desde la <em>obsesión por los detalles</em>, desde la disciplina,
            desde la experiencia de una mujer que aprendió sola a convertir gusto, fuerza y
            sensibilidad en una identidad.
          </p>

          <p class="historia-paragraph">
            Maison YR nace entre <em>viajes, noches sin dormir, ideas escritas en aeropuertos</em>,
            reuniones, pruebas de tejidos y decisiones tomadas desde el instinto. Cada pieza
            representa una parte de su historia: la elegancia, la sensualidad, el carácter y la
            energía de una mujer que <strong>nunca quiso parecerse a nadie</strong>.
          </p>

          <p class="historia-paragraph founder-lead">
            Su visión del lujo no está basada en mostrar riqueza.<br />
            Está basada en <em>hacer sentir algo</em>.
          </p>

          <p class="historia-paragraph">
            Desde el primer encaje seleccionado hasta el perfume que queda en la piel, todo en YR
            está pensado para provocar <em>presencia</em>. Una marca creada para mujeres que quieren
            sentirse <strong>inolvidables sin necesidad de hablar demasiado</strong>.
          </p>
        </div>
      </div>

      <div class="founder-quote">
        <span class="quote-mark" aria-hidden="true">"</span>
        <p class="quote-body">
          Yo no quería crear una marca <em>fría</em>.<br />
          Quería crear algo que hiciera sentir <strong>poderosa</strong> a una mujer cuando se
          mirara al espejo.<br />
          Algo elegante, sexy y fuerte… pero también <em>humano</em>.
        </p>
        <div class="quote-sign">— Yesenia Rodríguez</div>
      </div>

      <div class="founder-closing">
        <p class="historia-paragraph">
          Maison YR mezcla <em>feminidad, lujo moderno y carácter mediterráneo</em>. Inspirada
          entre <strong>Tenerife, Dubái y Latinoamérica</strong>, la marca une sensualidad,
          sofisticación y una estética internacional con identidad propia.
        </p>

        <p class="historia-paragraph">
          Porque YR no vende solamente lencería, perfumes o belleza.<br />
          <em>YR vende una sensación.</em>
        </p>

        <p class="founder-final">
          La diferencia entre una marca creada por tendencia y una marca creada por una mujer
          real… se nota en los <em>detalles</em>.<br />
          Y esa diferencia es <strong>Yesenia Rodríguez</strong>.
        </p>
      </div>
    </section>

    <!-- =========================================
         ORIGEN
         ========================================= -->
    <section class="historia-section" id="origen">
      <div class="historia-inner narrow">
        <div class="historia-eyebrow">— Origen</div>
        <h2 class="historia-h2">Esmeralda, <em>dorado</em>, glamour.</h2>
        <p class="historia-paragraph">
          La idea nació de tres símbolos que se cruzaron sin pedirlo: la <em>esmeralda colombiana</em>
          — piedra orgullo del territorio, verde profundo como el atelier; el <em>dorado</em> — color
          de la firma, de los herrajes, de los monogramas grabados a mano; y el <em>glamour europeo</em>
          — la lección de las maisons históricas: que el lujo se construye con tiempo, no con prisa.
        </p>
        <p class="historia-paragraph">
          Esos tres símbolos no son decoración. Son la paleta operativa de Maison YR. Verde esmeralda
          en cada packaging. Dorado en cada herraje, en cada emblema, en cada texto que importa. Y
          ese pulso europeo que se nota en el tejido, en las costuras invisibles, en el peso de la
          caja al abrirla.
        </p>
      </div>
    </section>

    <!-- =========================================
         ESENCIA — 6 valores
         ========================================= -->
    <section class="historia-section alt" id="esencia">
      <div class="historia-inner">
        <div class="historia-eyebrow centered">— Esencia</div>
        <h2 class="historia-h2 centered">Seis principios. <em>Una firma</em>.</h2>
        <p class="historia-paragraph centered narrow">
          La esencia de la maison se sostiene en seis valores que atraviesan cada decisión —
          desde el corte de un encaje hasta el peso del papel de la guía de uso.
        </p>
        <div class="valores-grid">
          {
            valores.map((v) => (
              <article class="valor-card">
                <div class="valor-roman">{v.roman}</div>
                <h3 class="valor-title">{v.title}</h3>
                <p class="valor-body">{v.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- =========================================
         VISIÓN 2030
         ========================================= -->
    <section class="historia-section" id="vision">
      <div class="historia-inner narrow">
        <div class="historia-eyebrow">— Visión 2030</div>
        <h2 class="historia-h2">Lo que <em>viene</em>.</h2>
        <p class="historia-paragraph">
          La maison crece sin perder su cadencia. La hoja de ruta hasta 2030 es deliberada — cada
          paso responde a la misma pregunta: ¿esto sigue siendo una firma, o se vuelve un catálogo?
        </p>
        <ul class="vision-list">
          {
            vision.map((item) => (
              <li class="vision-item">
                <span class="vision-arrow" aria-hidden="true">
                  →
                </span>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
        <div class="vision-cta">
          <a href="/lenceria" class="btn historia-btn" data-interactive data-magnetic>
            Explorar los universos →
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <WhatsAppFloat />
</BaseLayout>

<style>
  /* ============================
     HERO institucional compartido
     ============================ */
  .institutional-hero {
    padding: 160px 56px 80px;
    text-align: center;
    background: radial-gradient(ellipse at 50% 30%, rgba(212, 178, 102, 0.08), transparent 60%);
  }
  .institutional-kicker {
    font-family: 'Manrope', sans-serif;
    font-size: 11px;
    letter-spacing: 0.5em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 28px;
  }
  .institutional-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(48px, 7vw, 92px);
    font-weight: 300;
    line-height: 1;
    color: var(--ink);
    margin-bottom: 32px;
  }
  .institutional-title em {
    font-family: 'Forum', serif;
    font-style: normal;
    color: var(--gold);
  }
  .institutional-lede {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 20px;
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 680px;
    margin: 0 auto;
  }

  /* ============================
     Secciones de historia
     ============================ */
  .historia-section {
    padding: 100px 56px;
    background: var(--black);
    position: relative;
    scroll-margin-top: 80px; /* offset para el nav fijo cuando se hace scroll a #id */
  }
  .historia-section.alt {
    background: var(--black-2);
    border-top: 1px solid var(--line-soft);
    border-bottom: 1px solid var(--line-soft);
  }
  .historia-inner {
    max-width: 1100px;
    margin: 0 auto;
  }
  .historia-inner.narrow {
    max-width: 780px;
  }
  .historia-eyebrow {
    font-family: 'Manrope', sans-serif;
    font-size: 10px;
    letter-spacing: 0.5em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 24px;
  }
  .historia-eyebrow.centered {
    text-align: center;
  }
  .historia-h2 {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 300;
    line-height: 1.05;
    color: var(--ink);
    margin-bottom: 40px;
  }
  .historia-h2 em {
    font-family: 'Forum', serif;
    font-style: normal;
    color: var(--gold);
  }
  .historia-h2.centered {
    text-align: center;
  }
  .historia-paragraph {
    font-family: 'Cormorant Garamond', serif;
    font-size: 19px;
    line-height: 1.75;
    color: var(--ink-soft);
    max-width: 720px;
  }
  .historia-paragraph + .historia-paragraph {
    margin-top: 22px;
  }
  .historia-paragraph em {
    color: var(--gold);
    font-style: italic;
  }
  .historia-paragraph.centered {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
  }
  .historia-paragraph.narrow {
    max-width: 600px;
  }

  /* ============================
     Pull-quote (concepto)
     ============================ */
  .pullquote {
    max-width: 880px;
    margin: 80px auto 0;
    padding: 56px 24px 0;
    border-top: 1px solid var(--line-soft);
    text-align: center;
  }
  .pullquote p {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: clamp(28px, 4vw, 48px);
    line-height: 1.25;
    color: var(--ink);
    margin-bottom: 36px;
  }
  .pullquote p strong {
    font-family: 'Forum', serif;
    font-style: normal;
    font-weight: 400;
    color: var(--gold);
  }
  .pullquote cite {
    font-family: 'Forum', serif;
    font-style: normal;
    font-size: 13px;
    letter-spacing: 0.5em;
    text-transform: uppercase;
    color: var(--gold);
  }

  /* ============================
     Fundadora — retrato + texto
     ============================ */
  .historia-grid {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 80px;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
  }
  .historia-grid-text {
    min-width: 0;
  }
  .historia-portrait {
    min-width: 0;
  }
  .portrait-frame {
    aspect-ratio: 4/5;
    background:
      radial-gradient(ellipse at 50% 30%, rgba(14, 68, 52, 0.45) 0%, transparent 65%),
      linear-gradient(160deg, var(--black-3) 0%, var(--black) 100%);
    border: 1px solid var(--line-soft);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 28px;
    position: relative;
    overflow: hidden;
  }
  .portrait-frame::before {
    content: '';
    position: absolute;
    inset: 16px;
    border: 1px solid var(--line-soft);
    pointer-events: none;
  }
  .portrait-emblem {
    width: 92px;
    height: 92px;
    border-radius: 50%;
    border: 1.5px solid var(--gold);
    background: radial-gradient(circle at 30% 30%, var(--emerald) 0%, var(--emerald-deep) 70%);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 24px rgba(212, 178, 102, 0.3);
  }
  .portrait-emblem span {
    font-family: 'Forum', serif;
    font-size: 32px;
    color: var(--gold);
    letter-spacing: 0.08em;
  }
  .portrait-placeholder-label {
    font-family: 'Manrope', sans-serif;
    font-size: 10px;
    letter-spacing: 0.5em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }

  /* ============================
     Esencia — 6 valores grid
     ============================ */
  .valores-grid {
    margin-top: 56px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 36px;
  }
  .valor-card {
    padding: 32px 24px;
    background: var(--black);
    border: 1px solid var(--line-soft);
    display: flex;
    flex-direction: column;
    gap: 16px;
    transition:
      transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1),
      border-color 0.3s;
  }
  .valor-card:hover {
    transform: translateY(-3px);
    border-color: var(--gold-soft);
  }
  .valor-roman {
    font-family: 'Forum', serif;
    font-size: 32px;
    color: var(--gold);
    letter-spacing: 0.05em;
    margin-bottom: 4px;
  }
  .valor-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 26px;
    font-weight: 300;
    color: var(--ink);
    margin: 0;
  }
  .valor-body {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-soft);
    margin: 0;
  }

  /* ============================
     Visión 2030 — lista con flechas
     ============================ */
  .vision-list {
    list-style: none;
    margin: 32px 0 48px;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .vision-item {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    padding: 20px 0;
    border-bottom: 1px solid var(--line-soft);
    font-family: 'Cormorant Garamond', serif;
    font-size: 18px;
    line-height: 1.55;
    color: var(--ink);
  }
  .vision-item:last-child {
    border-bottom: 1px solid var(--line-soft);
  }
  .vision-arrow {
    color: var(--gold);
    font-family: 'Forum', serif;
    font-size: 22px;
    line-height: 1;
    margin-top: 2px;
    flex-shrink: 0;
  }
  .vision-cta {
    text-align: center;
    margin-top: 24px;
  }
  .historia-btn {
    display: inline-flex;
  }

  /* ============================
     Manifiesto (Cap. I) — destacados editoriales
     ============================ */
  .editorial-highlight {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 24px;
    line-height: 1.4;
    color: var(--ink);
    border-left: 1px solid var(--gold);
    padding-left: 24px;
    margin: 40px 0;
    max-width: 600px;
  }
  .editorial-highlight em {
    color: var(--gold);
    font-style: italic;
  }

  .manifesto-closing {
    margin: 60px auto 20px;
    padding: 30px 0;
    font-family: 'Cormorant Garamond', serif;
    font-size: 24px;
    line-height: 1.5;
    color: var(--ink);
    text-align: center;
    border-top: 1px solid var(--gold-soft);
    border-bottom: 1px solid var(--gold-soft);
    max-width: 700px;
  }
  .manifesto-closing em {
    font-family: 'Forum', serif;
    font-style: normal;
    color: var(--gold);
  }
  .manifesto-closing strong {
    font-weight: 400;
    color: var(--gold);
    font-style: italic;
  }

  /* ============================
     Fundadora (Cap. II) — credenciales, quote, cierre
     ============================ */
  .founder-credentials {
    font-family: 'Forum', serif;
    font-size: 14px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--gold);
    line-height: 1.8;
    margin-bottom: 32px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--gold-soft);
  }
  .founder-lead {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 22px;
    line-height: 1.5;
    color: var(--ink);
    border-left: 1px solid var(--gold);
    padding-left: 20px;
    margin: 32px 0;
  }
  .founder-quote {
    max-width: 900px;
    margin: 80px auto 0;
    text-align: center;
    position: relative;
    padding: 60px 40px;
    background: rgba(212, 178, 102, 0.04);
    border-top: 1px solid var(--gold-soft);
    border-bottom: 1px solid var(--gold-soft);
  }
  .founder-quote .quote-mark {
    position: absolute;
    top: 10px;
    left: 32px;
    font-family: 'Forum', serif;
    font-size: 120px;
    line-height: 1;
    color: var(--gold);
    opacity: 0.35;
  }
  .founder-quote .quote-body {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: clamp(22px, 3vw, 32px);
    font-weight: 300;
    line-height: 1.4;
    color: var(--ink);
    margin: 0;
  }
  .founder-quote .quote-body em {
    color: var(--gold);
    font-style: italic;
  }
  .founder-quote .quote-body strong {
    font-family: 'Forum', serif;
    font-style: normal;
    font-weight: 400;
    color: var(--gold);
  }
  .founder-quote .quote-sign {
    margin-top: 28px;
    font-family: 'Forum', serif;
    font-size: 12px;
    letter-spacing: 0.5em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .founder-closing {
    max-width: 900px;
    margin: 60px auto 0;
    text-align: center;
  }
  .founder-closing .historia-paragraph {
    margin-left: auto;
    margin-right: auto;
  }
  .founder-final {
    margin: 40px auto 0;
    padding-top: 30px;
    border-top: 1px solid var(--line-soft);
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 22px;
    line-height: 1.5;
    color: var(--ink-soft);
    max-width: 720px;
  }
  .founder-final em {
    color: var(--gold);
    font-style: italic;
  }
  .founder-final strong {
    font-family: 'Forum', serif;
    font-style: normal;
    font-weight: 400;
    color: var(--gold);
  }

  /* ============================
     Responsive
     ============================ */
