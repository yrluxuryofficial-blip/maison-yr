---
import allProducts from '../data/products.json';
import categories from '../data/categories.json';

// Solo se buscan piezas de categorías activas (Resort al lanzamiento): el resto
// abre la pantalla Próximamente y no tendría dónde mostrar el producto.
const activeSlugs = new Set(categories.filter((c) => c.active).map((c) => c.slug));
const products = allProducts.filter((p) => activeSlugs.has(p.category));
---

<div
  class="search-overlay"
  id="searchOverlay"
  role="dialog"
  aria-modal="true"
  aria-label="Buscar productos"
  hidden
>
  <button class="search-close" id="searchClose" aria-label="Cerrar búsqueda" type="button">×</button
  >

  <div class="search-inner">
    <label for="searchInput" class="search-label">Buscar en la maison</label>
    <div class="search-input-wrap">
      <svg
        class="search-icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="7"></circle>
        <line x1="16.5" y1="16.5" x2="21" y2="21"></line>
      </svg>
      <input
        type="text"
        id="searchInput"
        class="search-input"
        placeholder="Bikini, pareo, beach bag…"
        autocomplete="off"
      />
    </div>

    <div class="search-results" id="searchResults">
      <p class="search-hint">
        Escribí para empezar, o explorá la colección <a href="/resort" class="search-link">Resort</a
        >.
      </p>
    </div>
  </div>
</div>

<!-- Productos serializados como JSON inline para que el script los lea sin re-fetch -->
<script type="application/json" id="searchData" set:html={JSON.stringify(products)} />

<style>
  .search-overlay {
    position: fixed;
    inset: 0;
    z-index: 9000;
    background: rgba(5, 3, 2, 0.96);
    backdrop-filter: blur(20px);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 100px 24px 60px;
    overflow-y: auto;
    opacity: 0;
    transition: opacity 0.35s ease;
    pointer-events: none;
  }
  .search-overlay.open {
    opacity: 1;
    pointer-events: auto;
  }
  .search-overlay[hidden] {
    display: none;
  }
  :global(body.search-open) {
    overflow: hidden;
  }

  .search-close {
    position: absolute;
    top: 28px;
    right: 32px;
    background: transparent;
    border: 1px solid var(--gold-soft);
    color: var(--gold);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    font-family: 'Forum', serif;
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
    transition:
      background 0.3s,
      color 0.3s;
  }
  .search-close:hover {
    background: var(--gold);
    color: var(--black);
  }

  .search-inner {
    width: 100%;
    max-width: 720px;
    margin-top: 40px;
  }
  .search-label {
    display: block;
    font-family: 'Manrope', sans-serif;
    font-size: 10px;
    letter-spacing: 0.5em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 18px;
  }
  .search-input-wrap {
    position: relative;
    border-bottom: 1px solid var(--gold);
    padding: 12px 0 12px 40px;
    transition: border-color 0.3s;
  }
  .search-input-wrap:focus-within {
    border-color: var(--gold-bright);
  }
  .search-icon {
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 22px;
    height: 22px;
    color: var(--gold);
  }
  .search-input {
    width: 100%;
    background: transparent;
    border: none;
    outline: none;
    color: var(--ink);
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: clamp(22px, 3.5vw, 32px);
    line-height: 1.4;
  }
  .search-input::placeholder {
    color: var(--ink-mute);
  }

  .search-results {
    margin-top: 50px;
    min-height: 60px;
  }
  .search-hint {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    color: var(--ink-soft);
    font-size: 17px;
  }
  .search-link {
    color: var(--gold);
    text-decoration: none;
    border-bottom: 1px solid var(--gold-soft);
    transition: border-color 0.3s;
  }
  .search-link:hover {
    border-color: var(--gold);
  }

  :global(.search-result-list) {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  :global(.search-result) {
    display: grid;
    grid-template-columns: 80px 1fr auto;
    align-items: center;
    gap: 22px;
    padding: 16px;
    background: transparent;
    border: 1px solid transparent;
    color: inherit;
    text-decoration: none;
    text-align: left;
    transition:
      background 0.25s,
      border-color 0.25s,
      padding-left 0.25s;
    cursor: pointer;
  }
  :global(.search-result:hover),
  :global(.search-result:focus-visible) {
    background: rgba(212, 178, 102, 0.06);
    border-color: var(--line-soft);
    padding-left: 22px;
    outline: none;
  }
  :global(.search-result-img) {
    width: 80px;
    height: 80px;
    object-fit: cover;
    background: var(--black-3);
  }
  :global(.search-result-meta) {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  :global(.search-result-cat) {
    font-family: 'Manrope', sans-serif;
    font-size: 9px;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--gold);
  }
  :global(.search-result-name) {
    font-family: 'Cormorant Garamond', serif;
    font-size: 19px;
    color: var(--ink);
    line-height: 1.2;
  }
  :global(.search-result-price) {
    font-family: 'Forum', serif;
    font-size: 18px;
    color: var(--gold);
    white-space: nowrap;
  }
  :global(.search-empty) {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    color: var(--ink-mute);
    font-size: 17px;
    text-align: center;
    padding: 30px 0;
  }

  @media (max-width: 600px) {
    .search-overlay {
      padding: 70px 18px 40px;
    }
    .search-close {
      top: 20px;
      right: 18px;
      width: 38px;
      height: 38px;
      font-size: 20px;
    }
    :global(.search-result) {
      grid-template-columns: 60px 1fr;
      gap: 16px;
      padding: 12px;
    }
    :global(.search-result-img) {
      width: 60px;
      height: 60px;
    }
    :global(.search-result-price) {
      grid-column: 2;
      margin-top: 4px;
    }
  }
</style>

<script>
  type Product = {
    slug: string;
    name: string;
    category: string;
    categoryLabel: string;
    price: number;
    currency: string;
    image: string;
    imagePlaceholder: string;
    description: string;
    tags: string[];
  };

  const overlay = document.getElementById('searchOverlay') as HTMLDivElement | null;
  const closeBtn = document.getElementById('searchClose') as HTMLButtonElement | null;
  const input = document.getElementById('searchInput') as HTMLInputElement | null;
  const resultsBox = document.getElementById('searchResults') as HTMLDivElement | null;
  const dataNode = document.getElementById('searchData') as HTMLScriptElement | null;

  if (overlay && closeBtn && input && resultsBox && dataNode) {
    const products: Product[] = JSON.parse(dataNode.textContent ?? '[]');

    function openOverlay() {
      if (!overlay) return;
      overlay.hidden = false;
      requestAnimationFrame(() => overlay.classList.add('open'));
      document.body.classList.add('search-open');
      setTimeout(() => input?.focus(), 200);
    }

    function closeOverlay() {
      if (!overlay) return;
      overlay.classList.remove('open');
      document.body.classList.remove('search-open');
      setTimeout(() => {
        overlay.hidden = true;
        if (input) input.value = '';
        render('');
      }, 350);
    }

    // Triggers globales: cualquier elemento con data-search-trigger abre el overlay
    document.querySelectorAll<HTMLElement>('[data-search-trigger]').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        openOverlay();
      });
    });

    closeBtn.addEventListener('click', closeOverlay);
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) closeOverlay();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !overlay.hidden) closeOverlay();
    });

    // Case-insensitive + sin acentos (NFD + strip combining marks)
    function normalize(s: string): string {
      return s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
    }

    function escapeHtml(s: string): string {
      return s
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function render(query: string) {
      if (!resultsBox) return;
      const q = normalize(query.trim());
      if (!q) {
        resultsBox.innerHTML =
          '<p class="search-hint">Escribí para empezar, o explorá la colección <a href="/resort" class="search-link">Resort</a>.</p>';
        return;
      }
      const matches = products.filter((p) => {
        const hay = normalize(
          [p.name, p.categoryLabel, p.description, ...(p.tags || [])].join(' '),
        );
        return hay.includes(q);
      });
      if (matches.length === 0) {
        resultsBox.innerHTML =
          '<p class="search-empty">Sin resultados para "' +
          escapeHtml(query) +
          '". Probá con otra palabra.</p>';
        return;
      }
      const html =
        '<div class="search-result-list">' +
        matches
          .map(
            (p) => `
        <a class="search-result" href="/${p.category}#${p.slug}" data-slug="${escapeHtml(p.slug)}">
          <img class="search-result-img" src="${escapeHtml(p.image)}" data-fallback="${escapeHtml(p.imagePlaceholder)}" alt="" onerror="if(!this.dataset.fb){this.dataset.fb='1';this.src=this.dataset.fallback;}" />
          <div class="search-result-meta">
            <span class="search-result-cat">${escapeHtml(p.categoryLabel)}</span>
            <span class="search-result-name">${escapeHtml(p.name)}</span>
          </div>
          <span class="search-result-price">$${p.price} ${escapeHtml(p.currency)}</span>
        </a>
      `,
          )
          .join('') +
        '</div>';
      resultsBox.innerHTML = html;
    }

    input.addEventListener('input', () => render(input.value));
  }
</script>
