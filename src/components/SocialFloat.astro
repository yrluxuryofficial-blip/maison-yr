---
// Columna flotante de redes en la esquina inferior derecha, justo encima
// del botón flotante de WhatsApp. Instagram + TikTok en vertical.
// Los hrefs vienen de site.json.
import site from '../data/site.json';
---

<div class="social-float" aria-label="Redes sociales">
  <a
    href={site.social.instagram}
    target="_blank"
    rel="noopener"
    class="social-float-link"
    aria-label="Instagram"
    data-interactive
  >
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <rect x="3" y="3" width="18" height="18" rx="5" ry="5"></rect>
      <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
      <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
    </svg>
  </a>
  <a
    href={site.social.tiktok}
    target="_blank"
    rel="noopener"
    class="social-float-link"
    aria-label="TikTok"
    data-interactive
  >
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path
        d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5.8 20.1a6.34 6.34 0 0 0 10.86-4.43V8.9a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1.84-.33z"
      ></path>
    </svg>
  </a>
</div>

<style>
  /* Posicionado en columna sobre el WhatsApp:
     WhatsApp ocupa bottom:30 height:62 → su top está en ~92.
     Dejamos un gap de 16px y arrancamos la columna en bottom:108. */
  .social-float {
    position: fixed;
    right: 37px; /* alineado con el centro horizontal del WhatsApp (30 + 62/2 - 48/2 = 37) */
    bottom: 108px;
    z-index: 149; /* uno menos que el WhatsApp (150) — el WhatsApp es el "ancla" visual */
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .social-float-link {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(5, 3, 2, 0.92);
    border: 1px solid var(--gold-soft);
    color: var(--gold-soft);
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    backdrop-filter: blur(6px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.25);
    transition:
      transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
      background 0.35s,
      color 0.35s,
      border-color 0.35s,
      box-shadow 0.35s;
  }
  .social-float-link:hover {
    transform: translateY(-3px) scale(1.06);
    background: var(--gold);
    color: var(--black);
    border-color: var(--gold);
    box-shadow: 0 12px 24px rgba(212, 178, 102, 0.35);
  }
  .social-float-link svg {
    width: 20px;
    height: 20px;
  }

  @media (max-width: 980px) {
    .social-float {
      right: 30px; /* alineado con el WhatsApp mobile (right:20 width:54 → centro 47, link width 40 → right ~27) */
      bottom: 88px;
      gap: 10px;
    }
    .social-float-link {
      width: 40px;
      height: 40px;
    }
    .social-float-link svg {
      width: 17px;
      height: 17px;
    }
  }
</style>
